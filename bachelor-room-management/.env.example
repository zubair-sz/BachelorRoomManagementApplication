# Backend settings. Every value has a working default for local development,
# so you only need these in a real deployment. Export them or set them in your hosting provider.

DB_URL=jdbc:postgresql://localhost:5432/brm_db
DB_USERNAME=brm_user
DB_PASSWORD=brm_password

# Base64-encoded secret, at least 256 bits. Generate one with:  openssl rand -base64 48
# CHANGE THIS before deploying: anyone who knows the secret can forge login tokens.
JWT_SECRET=c2VjcmV0LWtleS1mb3ItZGV2LWVudmlyb25tZW50LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9u
JWT_EXPIRATION_MS=86400000

# Browser origin(s) allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173

# Decides what "today" means and when the midnight chore job runs.
APP_TIMEZONE=Asia/Kolkata

# Where uploaded photos/videos are stored on disk.
UPLOAD_DIR=./uploads

# Frontend (put in frontend/.env): currency used when showing money.
# VITE_CURRENCY=INR
